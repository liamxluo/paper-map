{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paper Map",
  "version": "3.1.8",
  "identifier": "io.github.liamxluo.papermap",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Paper Map",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "copyright": "Copyright 2026 liamxluo · Apache License 2.0",
    "shortDescription": "Your research desk: every paper and book in one place, read with your notes beside them, synced with Zotero, and mapped when you need to think, as vector PDF or SVG.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 200
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 200
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxOTk4NTQzMTdEMUM3OTMKUldTVHg5RVhRNFdaTVZjeVFjdmlGcStydGNLakxia1VsR0F1SzN1Z3lHWjlFMGNBL1QxaUJoUlAK",
      "endpoints": [
        "https://github.com/liamxluo/paper-map/releases/latest/download/latest.json"
      ]
    }
  }
}